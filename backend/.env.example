# Variáveis do back-end. Copie para backend/.env e preencha. O .env nunca vai para o git.
# Só chaves e dados de demonstração (regulamento 3.8).
#
# Usado pelos dois composes (dev e produção) e por quem roda o back-end direto na máquina.
# Em Render ou outra hospedagem, as mesmas variáveis vão no painel da plataforma.

# Supabase na nuvem: um projeto só, com dados fictícios, para dev e demo.
# Onde achar: painel do Supabase > Project Settings > API Keys (e Data API, para a URL).
SUPABASE_URL=
# Chave secreta (sb_secret_...). Só o back-end usa. Nunca vai para o front nem para a tela.
SUPABASE_SECRET_KEY=

# Gemini, a IA da busca com justificativa (0039). Onde achar: aistudio.google.com > API keys.
# Sem ela, a busca usa as respostas gravadas da demo (RNF-04).
GEMINI_API_KEY=

# Login com Google (RF-23). Não é usado pelo back: só pelo supabase/ligar_google.sh.
# Onde achar: Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth (Aplicativo da Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
